{
  "$schema": "https://agentshield.dev/schemas/guardrail-policy.json",
  "id": "no-crypto-v1",
  "name": "Anti-Cryptocurrency Mining & Abuse",
  "description": "Prevents agents from being hijacked for crypto mining, wallet draining, or blockchain abuse. Blocks all crypto-related tool calls and patterns.",
  "version": "1.0.0",
  "allowedTools": [
    "search_web",
    "read_document",
    "summarize_text",
    "analyze_data",
    "generate_report",
    "send_email",
    "create_ticket"
  ],
  "forbiddenTools": [
    "execute_shell",
    "execute_sql",
    "deploy_contract",
    "sign_transaction",
    "connect_wallet",
    "mine_crypto",
    "stake_tokens",
    "bridge_assets",
    "swap_tokens",
    "mint_nft",
    "call_rpc"
  ],
  "maxParamValues": {
    "compute_units": 1000000,
    "gas_limit": 21000,
    "token_amount": 0
  },
  "forbiddenPatterns": [
    "ethereum",
    "bitcoin",
    "solana",
    "polygon",
    "binance smart chain",
    "avalanche",
    "arbitrum",
    "optimism",
    "base chain",
    "web3",
    "smart contract",
    "private key",
    "seed phrase",
    "mnemonic",
    "wallet address",
    "0x[a-fA-F0-9]{40}",
    "mining",
    "staking",
    "yield farming",
    "liquidity pool",
    "dex swap",
    "bridge",
    "erc20",
    "erc721",
    "erc1155",
    "spend permission",
    "permit2",
    "eip-2612",
    "eip-712",
    "DROP TABLE",
    "DELETE FROM",
    "TRUNCATE TABLE",
    "rm -rf",
    "chmod 777",
    "mkfs\\.",
    "IGNORE ALL PREVIOUS INSTRUCTIONS",
    "DISREGARD PRIOR RULES",
    "\\[SYSTEM OVERRIDE\\]",
    "ADMIN_OVERRIDE_KEY",
    "NEW SYSTEM PROMPT:"
  ],
  "requiredFields": [],
  "rateLimit": {
    "maxCallsPerMinute": 60
  },
  "maxCostPerSession": 100,
  "circuitBreaker": {
    "maxRepeatedCalls": 3,
    "timeWindowMs": 5000
  },
  "enableInjectionSanitizer": true,
  "timeoutMs": 30000,
  "requireApproval": false
}