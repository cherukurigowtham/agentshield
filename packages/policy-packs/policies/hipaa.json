{
  "$schema": "https://agentshield.dev/schemas/guardrail-policy.json",
  "id": "hipaa-v1",
  "name": "HIPAA Healthcare Data Protection",
  "description": "Policy pack for HIPAA-compliant healthcare agent operations. Enforces PHI protection, access controls, and audit requirements.",
  "version": "1.0.0",
  "allowedTools": [
    "query_patient_records",
    "schedule_appointment",
    "send_secure_message",
    "generate_clinical_summary",
    "check_insurance_eligibility",
    "prescribe_medication",
    "order_lab_test"
  ],
  "forbiddenTools": [
    "export_database",
    "bulk_download_records",
    "execute_sql",
    "execute_shell",
    "modify_user_permissions"
  ],
  "maxParamValues": {
    "patient_records_limit": 50,
    "message_length": 5000,
    "prescription_quantity": 90
  },
  "forbiddenPatterns": [
    "DROP TABLE",
    "DELETE FROM",
    "TRUNCATE TABLE",
    "SELECT \\* FROM patients",
    "SELECT \\* FROM medical_records",
    "rm -rf",
    "chmod 777",
    "mkfs\\.",
    "IGNORE ALL PREVIOUS INSTRUCTIONS",
    "DISREGARD PRIOR RULES",
    "\\[SYSTEM OVERRIDE\\]",
    "ADMIN_OVERRIDE_KEY",
    "NEW SYSTEM PROMPT:",
    "social security number",
    "ssn",
    "date of birth",
    "dob"
  ],
  "requiredFields": [
    "patient_id",
    "provider_id",
    "purpose_code",
    "access_timestamp"
  ],
  "rateLimit": {
    "maxCallsPerMinute": 20
  },
  "maxCostPerSession": 1000,
  "circuitBreaker": {
    "maxRepeatedCalls": 2,
    "timeWindowMs": 10000
  },
  "enableInjectionSanitizer": true,
  "timeoutMs": 60000,
  "requireApproval": true
}